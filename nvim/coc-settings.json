{
    "inlayHint": false,
    "languageserver": {
        "lua": {
            "command": "lua-language-server",
            "filetypes": [
                "lua"
            ],
            "rootPatterns": [
                ".git/",
                "init.lua",
                "init.json"
            ],
            "settings": {
                "Lua": {
                    "diagnostics": {
                        "globals": [
                            "vim"
                        ]
                    },
                    "workspace": {
                        "library": {
                            "/usr/share/nvim/runtime/lua": true,
                            "/path/to/your/lua/libs": true
                        }
                    }
                }
            }
        },
        "bash": {
            "command": "bash-language-server",
            "args": [
                "start"
            ],
            "filetypes": [
                "sh",
                "bash"
            ],
            "rootPatterns": [
                ".git/"
            ],
            "settings": {}
        },
        "python": {
            "command": "pyright-langserver",
            "args": [
                "--stdio"
            ],
            "filetypes": [
                "python"
            ],
            "rootPatterns": [
                ".git/"
            ],
            "settings": {
                "python": {
                    "pythonPath": "/usr/bin/python3",
                    "autoFormat": true
                }
            }
        },
        "c": {
            "command": "clangd",
            "args": [
                "--background-index",
                "--completion-style=detailed",
                "--header-insertion=never",
                "--all-scopes-completion",
                "--compile-commands-dir=${workspaceFolder}",
                "--log=info",
                "-j=2",
                "--pch-storage=memory",
                "--pretty",
                "--function-arg-placeholders=false",
                "--enable-config"
            ],
            "filetypes": [
                "c",
                "cpp",
                "objc",
                "objcpp"
            ],
            "rootPatterns": [
                ".git/",
                ".clangd",
                "compile_commands.json"
            ],
            "settings": {}
        }
    },
    "tagging.enable": true,
    "tagging.useCtags": true,
    "tagging.ctagsPath": "ctags",
    "tagging.ctagsArgs": [
        "--fields=+niazS",
        "--extras=+q",
        "--c++-kinds=+px",
        "--c-kinds=+px"
    ],
    "suggest.noselect": false,
    "diagnostic.checkCurrentLine": true,
    "suggest.autoTrigger": "always",
    "diagnostic.enable": true,
    "diagnostic.virtualText": true
}
